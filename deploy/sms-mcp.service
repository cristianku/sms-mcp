# Hardened systemd unit for sms-mcp.
#
# Install:
#   install -m 0755 sms-mcp /usr/local/bin/sms-mcp
#   install -d -m 0750 /etc/sms-mcp
#   install -m 0640 config.example.yaml /etc/sms-mcp/config.yaml   # then edit
#   # token: one random line, e.g. `openssl rand -hex 32 > /etc/sms-mcp/token`
#   # then make it readable by the service only (see LoadCredential below)
#   cp deploy/sms-mcp.service /etc/systemd/system/ && systemctl daemon-reload
#
# Pair once (writes the session into the state directory):
#   systemd-run --pty -p DynamicUser=yes -p StateDirectory=sms-mcp \
#     -p WorkingDirectory=/var/lib/sms-mcp \
#     /usr/local/bin/sms-mcp pair -config /etc/sms-mcp/config.yaml
# Then: systemctl enable --now sms-mcp

[Unit]
Description=sms-mcp (Google Messages SMS/RCS as MCP tools)
Documentation=https://github.com/cristianku/sms-mcp
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sms-mcp serve -config /etc/sms-mcp/config.yaml
Restart=on-failure
RestartSec=10s

DynamicUser=yes
StateDirectory=sms-mcp
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sms-mcp
UMask=0077
Environment=SMS_MCP_SESSION_FILE=/var/lib/sms-mcp/session.json
Environment=SMS_MCP_AUDIT_FILE=/var/lib/sms-mcp/audit.jsonl
# Token passed as a systemd credential; readable only by this service.
LoadCredential=token:/etc/sms-mcp/token
Environment=SMS_MCP_TOKEN_FILE=%d/token

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
